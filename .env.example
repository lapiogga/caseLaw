# ─────────────────────────────────────────────────────
# CaseLaw MCP — 환경변수 템플릿
# 사용 방법:
#   1. 본 파일을 .env 로 복사
#   2. 실제 값을 채움
#   3. .env 는 .gitignore에 의해 절대 커밋되지 않음
# ─────────────────────────────────────────────────────

# 법제처 OPEN API 인증 ID (필수)
# - 발급: https://open.law.go.kr/LSO/openApi/cuAskList.do
# - 마이페이지 > API인증키관리 에서 확인 (보통 이메일 ID 앞부분)
# - 예시: lapiogga
CASELAW_OC=

# 캐시 DB 경로 (선택, 기본값: ~/.caselaw_mcp/cache.db)
# 예: D:/cache/caselaw.db
CASELAW_CACHE_PATH=

# 로그 레벨 (선택, 기본 INFO). DEBUG/INFO/WARNING/ERROR
CASELAW_LOG_LEVEL=INFO

# Rate Limit (선택, 기본 5 req/sec)
CASELAW_RATE_LIMIT_PER_SEC=5

# HTTP 타임아웃 초 (선택, 기본 15)
CASELAW_HTTP_TIMEOUT=15
